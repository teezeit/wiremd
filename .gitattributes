# Keep markdown files LF on Windows checkouts so log parsers (review-gate
# test, build-review-log, flag-review) see consistent line endings.
*.md text eol=lf

# Preserve CRLF for the fixture that exists *to test* CRLF handling.
packages/core/tests/fixtures/regressions/formatting/crlf-line-endings.md text eol=crlf

# Bundled CLI shipped with the Claude skill — generated by scripts/build-bundle.mjs.
# Excluded from GitHub language stats so it doesn't dominate the breakdown.
extensions/skills/wireframe/bin/wiremd linguist-generated=true
extensions/skills/wireframe/bin/wiremd.js linguist-generated=true
